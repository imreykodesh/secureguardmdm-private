<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep captured firewall metadata and policies local to this device. -->
        <exclude domain="database" path="secure_guard_database" />
        <exclude domain="database" path="secure_guard_database-journal" />
        <exclude domain="database" path="secure_guard_database-shm" />
        <exclude domain="database" path="secure_guard_database-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="secure_guard_database" />
        <exclude domain="database" path="secure_guard_database-journal" />
        <exclude domain="database" path="secure_guard_database-shm" />
        <exclude domain="database" path="secure_guard_database-wal" />
    </device-transfer>
</data-extraction-rules>
